{
  "title": "Chaos: the search takes 10 seconds",
  "description": "Template. The search API answers 10 s late (the real request goes through); the page must show a loading state meanwhile and recover. Replace every REPLACE_* value. See templates/routines/README.md.",
  "tags": ["chaos", "fault-injection"],
  "surface": "REPLACE_SURFACE",
  "status": "draft",
  "targetProfile": "REPLACE_TARGET_PROFILE",
  "credentialSet": "REPLACE_CREDENTIAL_SET",
  "steps": [
    { "id": "auth", "label": "Log in", "action": "include", "routineId": "login", "version": 1 },
    { "id": "open-page", "label": "Open the page under test", "action": "goto", "url": "REPLACE_PAGE_URL", "timeoutMs": 30000 },
    { "id": "wait-page-ready", "label": "Wait for the page to settle", "action": "waitForLoadState", "state": "networkidle", "timeoutMs": 15000 },
    {
      "id": "slow-search",
      "label": "The search request arrives 10 seconds late",
      "action": "injectFault",
      "match": { "urlContains": "REPLACE_API_PATH" },
      "fault": { "delayMs": 10000 },
      "times": 1
    },
    { "id": "search", "label": "Do what searches", "action": "click", "selector": "REPLACE_TRIGGER_SELECTOR", "timeoutMs": 10000 },
    { "id": "assert-loading", "label": "While it waits the user sees a loading state", "action": "assertVisible", "selector": "REPLACE_LOADING_SELECTOR", "timeoutMs": 5000 },
    { "id": "wait-recovered", "label": "The loading state goes away when the answer arrives", "action": "waitForSelector", "selector": "REPLACE_LOADING_SELECTOR", "state": "hidden", "timeoutMs": 30000 },
    { "id": "assert-no-leak", "label": "No stack trace, exception or SQL error on screen", "action": "assertNoTextMatches" },
    { "id": "shot", "label": "Evidence", "action": "screenshot", "name": "search-slow" }
  ]
}
