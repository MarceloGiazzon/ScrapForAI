NODE_ENV=development
PORT=3000
# Loopback only by default. Set to 0.0.0.0 ONLY if you intentionally want to expose the
# service on your network — it drives a real browser and is guarded by a single API key.
HOST=127.0.0.1

SCRAPFORAI_API_KEY=replace-with-strong-random-value

ALLOWED_TARGET_ORIGINS=https://dev.example.com,https://qa.example.com
ALLOWED_RESOURCE_ORIGINS=https://dev.example.com,https://qa.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

MAX_STEPS_PER_JOB=50
# T6.4: actors (one isolated browser context, i.e. one session, each; `main` counts) a single run may use.
MAX_ACTORS_PER_JOB=5
JOB_TIMEOUT_MS=60000
STEP_TIMEOUT_MS=10000
MAX_REQUEST_BODY_SIZE=1mb
MAX_PARALLEL_JOBS=2
# Slots that suites/scheduled runs may NOT take, so an ad-hoc request is not locked out by a long suite.
# Capped at MAX_PARALLEL_JOBS - 1 (a suite always keeps one slot). 0 turns the reservation off.
INTERACTIVE_RESERVED_SLOTS=1
MAX_DOM_SNAPSHOT_CHARS=20000

# WARNING: evaluate/watch execute ARBITRARY in-page JavaScript and can mutate the page.
# Enable ONLY for local, trusted use against allowlisted dev origins. Keep false in any
# shared, staging, or production deployment.
# true: a request to an origin outside ALLOWED_TARGET_ORIGINS / ALLOWED_RESOURCE_ORIGINS is ABORTED (and reported, with
# evidence.routing handledBy=allowlist-guard) instead of only reported. Off by default: a page that depends on a CDN would break.
BLOCK_UNEXPECTED_RESOURCES=false
ALLOW_EVALUATE=false
MAX_EVALUATE_SCRIPT_CHARS=4000
MAX_EVALUATE_RESULT_CHARS=20000
EVALUATE_TIMEOUT_MS=5000
MAX_WATCH_DURATION_MS=30000
MIN_WATCH_INTERVAL_MS=100
MAX_WATCH_SAMPLES=200

ARTIFACT_RETENTION_HOURS=4

# --- Evidence retention ---
# ephemeral (default) uses ARTIFACT_RETENTION_HOURS above; options.retention: "standard" keeps this many days.
STANDARD_RETENTION_DAYS=30
# Cap on pinned evidence (POST /v1/runs/:jobId/pin). Past it, pins are refused with 409; nothing is deleted.
PINNED_EVIDENCE_MAX_MB=2048

# --- Regression vault ---
# Where regression items live (<ITEM-ID>.json). Point it inside the repo that owns the ledger to review items in PRs.
# Default: <dataDir>/regression-vault
# REGRESSION_VAULT_DIR=

# --- System evolution ---
# Where `scrapforai evolution snapshot` writes <target>/<date>_<buildId>/. If it is inside a git repository, each snapshot
# is committed with its build id in the message. Snapshots hold value-free inventories and (unless --no-screenshots) screenshots.
# Default: <dataDir>/system-evolution
# SYSTEM_EVOLUTION_DIR=

# --- Routine library ---
# Where saved routines live (<id>/v<N>.json). Point it inside a git repo to review routines in PRs.
# Default: <dataDir>/library
# ROUTINE_LIBRARY_DIR=

# --- Credential vault ---
# 32-byte AES key, base64 (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Unset = a key file is generated at <dataDir>/vault.key (owner-only). Setting it keeps the key off the
# disk that holds credentials.enc.json. Losing the key makes the vault unreadable.
# SCRAPFORAI_VAULT_KEY=
# Deprecated: accept literal "credentials" in REST request bodies. false = vault only (credentialSet).
ALLOW_INLINE_CREDENTIALS=true

# Leave both unset to use the per-user data directory:
#   Windows: %LOCALAPPDATA%\ScrapForAI
#   Linux:   ~/.local/share/scrapforai
# SCRAPFORAI_DATA_DIR=
# ARTIFACT_DIR=
LOG_LEVEL=info
PLAYWRIGHT_BROWSER=chromium

# Force every run headless, ignoring a request's headless:false. The "Light" distribution sets
# this to true because it bundles only the headless-shell browser (no full Chromium for headed
# runs). Leave false on the full distribution to allow headed runs.
FORCE_HEADLESS=false

# --- Run history index ---
# The compact run index is kept far longer than the heavy evidence above: roughly 500 bytes
# per run versus 1-20 MB. Screenshots and traces expire on ARTIFACT_RETENTION_HOURS; the
# history list survives for HISTORY_RETENTION_DAYS.
HISTORY_RETENTION_DAYS=90
HISTORY_MAX_RUNS=5000

# --- Scheduler (T3.2) ---
# Runs the stored schedules (PUT /v1/schedules/:id) from inside this process: only while it is up. A missed occurrence is made up ONCE at startup.
# For a machine that is not always on, register a Windows task that calls the CLI instead (scripts/ops/Register-VaultNightlyTask.ps1).
SCHEDULER_ENABLED=false
SCHEDULER_TICK_SECONDS=15
# Scheduled runs never use evaluate/watch unless this is true.
SCHEDULED_ALLOW_EVALUATE=false

# --- Notifications (T3.3) ---
# Webhooks (PUT /v1/webhooks/:id) may post ONLY to these exact origins; empty = nothing leaves the server. The URL itself is a secret and lives in the credential vault.
# Examples: https://hooks.slack.com, https://chat.googleapis.com, https://prod-12.westus.logic.azure.com (Teams Workflows)
ALLOWED_NOTIFY_ORIGINS=
NOTIFY_TIMEOUT_MS=10000

# --- Periodic summary (T9.3) ---
# Where `summary` schedules write their .md/.json files (default <dataDir>/summaries). Delivery to webhooks uses the notification settings above.
# SUMMARY_OUTPUT_DIR=

# --- Performance series (T3.4) ---
# Every run of a library routine records how long each step took. Baseline = median of the last PERF_BASELINE_RUNS green runs BEFORE the last
# PERF_RECENT_RUNS; alert when the median of those recent runs is above baseline x PERF_ALERT_RATIO AND at least PERF_MIN_DELTA_MS slower.
PERF_BASELINE_RUNS=20
PERF_RECENT_RUNS=3
PERF_MIN_BASELINE_RUNS=5
PERF_ALERT_RATIO=1.3
PERF_MIN_DELTA_MS=100
PERF_MAX_RECORDS=500

# Flakiness (T3.5). Score = pass<->fail changes between consecutive runs (same routine version, profile, origin and build) / comparable pairs, over the
# last FLAKY_WINDOW runs. At or above FLAKY_THRESHOLD with at least FLAKY_MIN_RUNS runs, quarantine is SUGGESTED (never applied by itself).
FLAKY_WINDOW=20
FLAKY_MIN_RUNS=10
FLAKY_THRESHOLD=0.2

# --- Web UI ---
# Serves the history/config UI at http://127.0.0.1:<PORT>/ui
UI_ENABLED=true
SESSION_TTL_MINUTES=480

# MCP server (npm run mcp) — a stdio bridge that proxies MCP tool calls to this same
# ScrapForAI REST API. It reuses SCRAPFORAI_API_KEY above as its bearer token and, by
# default, targets http://127.0.0.1:<PORT>. Both of the following are optional overrides.
# SCRAPFORAI_MCP_BASE_URL=http://127.0.0.1:3000
# SCRAPFORAI_MCP_REQUEST_TIMEOUT_MS=120000
